# Your Anthropic API key — get it from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Your Shopify store domain (no https://, no trailing slash)
# Example: my-test-store.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Shopify Admin API token — needs write_orders scope
# Create one at: Shopify Admin → Settings → Apps → Develop apps
SHOPIFY_ADMIN_TOKEN=shpat_...

# Comma-separated list of allowed CORS origins
# During local dev with ngrok you can leave this as *
# In production, set this to your Shopify store URL
ALLOWED_ORIGINS=*

# Claude Managed Agent IDs — auto-generated on first run, then saved here
# Leave blank on first run; the server will create them and write them back
AGENT_ID=
ENVIRONMENT_ID=

# Twilio — for WhatsApp channel
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=SKbc...
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+1...

# Resend — for defective order email notifications
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_...

# Email address that receives defective order reports
STORE_OWNER_EMAIL=you@example.com
